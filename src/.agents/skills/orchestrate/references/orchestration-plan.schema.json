{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openai.local/schemas/orchestration-plan.schema.json",
  "title": "Orchestration plan contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lane",
    "summary",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "lane": {
      "type": "string",
      "enum": [
        "single-agent",
        "plan-light",
        "orchestrate-heavy"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/task"
      }
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "goal",
        "files",
        "depends_on",
        "risk",
        "acceptance_criteria",
        "verify_cmds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "review"
          ]
        },
        "goal": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "files": {
          "$ref": "#/definitions/stringList"
        },
        "depends_on": {
          "$ref": "#/definitions/stringList"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "acceptance_criteria": {
          "allOf": [
            {
              "$ref": "#/definitions/stringList"
            },
            {
              "minItems": 1
            }
          ]
        },
        "verify_cmds": {
          "$ref": "#/definitions/stringList"
        }
      }
    }
  }
}
